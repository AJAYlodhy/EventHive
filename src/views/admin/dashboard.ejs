<!-- Dashboard Stats Cards -->
<section class="dashboard-cards">
  <div class="stat-card stat-card--users">
    <div class="stat-card__icon">👥</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.totalUsers.toLocaleString() %></span>
      <span class="stat-card__label">Total Users</span>
    </div>
  </div>

  <div class="stat-card stat-card--organizers">
    <div class="stat-card__icon">🏢</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.totalOrganizers %></span>
      <span class="stat-card__label">Total Organizers</span>
    </div>
  </div>

  <div class="stat-card stat-card--events">
    <div class="stat-card__icon">🎪</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.totalEvents %></span>
      <span class="stat-card__label">Total Events</span>
    </div>
  </div>

  <div class="stat-card stat-card--approvals">
    <div class="stat-card__icon">⏳</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.pendingApprovals %></span>
      <span class="stat-card__label">Pending Approvals</span>
    </div>
  </div>

  <div class="stat-card stat-card--providers">
    <div class="stat-card__icon">🔧</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.serviceProviders %></span>
      <span class="stat-card__label">Service Providers</span>
    </div>
  </div>

  <div class="stat-card stat-card--applications">
    <div class="stat-card__icon">📄</div>
    <div class="stat-card__info">
      <span class="stat-card__value"><%= stats.pendingApplications %></span>
      <span class="stat-card__label">Pending Applications</span>
    </div>
  </div>
</section>

<!-- Recent Events -->
<section class="dashboard-section">
  <div class="section-header">
    <h2 class="section-title">Recent Events</h2>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Event</th>
          <th>Organizer</th>
          <th>Date</th>
          <th>Status</th>
          <th>Attendees</th>
        </tr>
      </thead>
      <tbody>
        <% recentEvents.forEach(function(event) { %>
          <tr>
            <td><strong><%= event.title %></strong></td>
            <td><%= event.organizer %></td>
            <td><%= new Date(event.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
            <td>
              <span class="status-badge status-badge--<%= event.status %>">
                <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
              </span>
            </td>
            <td><%= event.attendees > 0 ? event.attendees.toLocaleString() : '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<!-- Pending Approvals -->
<section class="dashboard-section">
  <div class="section-header">
    <h2 class="section-title">Pending Approvals</h2>
    <span class="section-count"><%= pendingApprovals.length %> pending</span>
  </div>
  <div class="approval-list">
    <% pendingApprovals.forEach(function(item) { %>
      <div class="approval-card">
        <div class="approval-card__header">
          <span class="approval-card__type approval-card__type--<%= item.type %>">
            <%= item.type === 'event' ? '🎪 Event' : item.type === 'organizer' ? '🏢 Organizer' : '🔧 Service Provider' %>
          </span>
          <span class="approval-card__date"><%= new Date(item.requestedDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
        </div>
        <h3 class="approval-card__title"><%= item.title %></h3>
        <p class="approval-card__desc"><%= item.description %></p>
        <div class="approval-card__footer">
          <span class="approval-card__requester">Requested by: <strong><%= item.requestedBy %></strong></span>
          <div class="approval-card__actions">
            <button class="btn btn--approve" title="Approve">✓ Approve</button>
            <button class="btn btn--reject" title="Reject">✗ Reject</button>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>
